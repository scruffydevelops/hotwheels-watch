// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Hot Wheels stock watch ----------
// Each user has their own addresses, wishlist, and notification topic.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  ntfyTopic     String    @unique
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  addresses ScalpAddress[]
  wishlist  WishlistItem[]
}

model ScalpAddress {
  id          String @id @default(cuid())
  userId      String
  label       String
  city        String
  addressText String
  query       String // combined "addressText, city" string used for geocoding + search
  lat         Float
  lng         Float

  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products TrackedProduct[]
}

// A specific product name/keyword to search for, in addition to the generic
// "hot wheels" search, at every saved address for this user.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackedProduct {
  id          String  @id @default(cuid())
  addressId   String
  platform    String  @default("blinkit")
  productId   String
  name        String
  brand       String?
  price       Float?
  mrp         Float?
  inventory   Int?
  imageUrl    String?
  productUrl  String?
  inStock     Boolean @default(true)
  sourceQuery String  @default("hot wheels") // which search term found this product

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  address ScalpAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@unique([addressId, platform, productId])
  @@index([addressId, lastSeenAt])
}
